# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Public Server Base URL (used to generate download links for Telegram buttons)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database Storage File
DATABASE_URL=./data/bot.db

# Security & Expiry Settings
DOWNLOAD_TOKEN_SECRET=super-secret-random-key-change-in-production
TOKEN_EXPIRY_SECONDS=900

# YouTube Cookies (Optional - to bypass YouTube "Sign in to confirm you're not a bot" on datacenter IPs)
# Option 1: Path to cookies.txt (defaults to ./cookies.txt if present in project root)
# YOUTUBE_COOKIES_PATH=./cookies.txt
# Option 2: Raw Netscape cookie content directly pasted as environment variable on Render
# YOUTUBE_COOKIES_CONTENT=

